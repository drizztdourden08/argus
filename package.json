{
  "name": "argus",
  "version": "0.1.0",
  "private": true,
  "description": "Argus: the coordination dashboard of every project on this machine.",
  "license": "UNLICENSED",
  "author": {
    "name": "drizztdourden_",
    "email": "drizztdourden08@users.noreply.github.com"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "standards lint && pnpm --filter @argus/web typecheck",
    "lint:all": "standards lint --all && pnpm --filter @argus/web typecheck",
    "lint:md": "markdownlint-cli2",
    "structure": "brock structure --check",
    "test": "standards test && pnpm test:rust",
    "test:pr": "standards test pr && node scripts/rust-tests.mjs --tag standard --changed",
    "test:e2e": "standards test e2e && node scripts/rust-tests.mjs --tag e2e --changed",
    "test:rust": "node scripts/rust-tests.mjs --tag critical --changed",
    "build": "pnpm --filter ./apps/web build",
    "prose": "brock prose",
    "deadcode": "brock knip",
    "duplicates": "jscpd .",
    "icons": "node tools/icons/render-argus-icons.mjs"
  },
  "devDependencies": {
    "@drizztdourden08/brock-build": "^0.116.0",
    "@drizztdourden08/brock-lint-config": "^0.116.0",
    "@drizztdourden08/standards": "^0.14.7",
    "@resvg/resvg-js": "2.6.2",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "markdownlint-cli2": "catalog:",
    "vitest": "catalog:"
  },
  "brock": {
    "version": "0.106.0"
  },
  "packageManager": "pnpm@10.17.0"
}
