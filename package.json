{
  "name": "argus",
  "version": "0.1.0",
  "private": true,
  "description": "Argus: the coordination dashboard of every project on this machine.",
  "license": "UNLICENSED",
  "author": {
    "name": "drizztdourden_",
    "email": "drizztdourden08@users.noreply.github.com"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm -r lint && brock prose && brock knip && jscpd .",
    "lint:md": "markdownlint-cli2",
    "structure": "brock structure --check",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm --filter ./apps/web build",
    "prose": "brock prose",
    "deadcode": "brock knip",
    "duplicates": "jscpd ."
  },
  "devDependencies": {
    "@drizztdourden08/brock-build": "^0.110.0",
    "@drizztdourden08/brock-lint-config": "^0.110.0",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "markdownlint-cli2": "catalog:",
    "vitest": "catalog:"
  },
  "brock": {
    "version": "0.106.0"
  },
  "packageManager": "pnpm@10.17.0"
}
