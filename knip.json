{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        ".markdownlint-cli2.mjs",
        "brock.workspace.mjs",
        "eslint.config.mjs",
        "stylelint.config.mjs"
      ],
      "project": [
        "*.{mjs,ts}"
      ]
    },
    "apps/web": {
      "entry": [
        "*.config.{cjs,ts,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  }
}
