      "color": "rose",
      "collection": "items",
      "parents": ["epic", "story"],
      "stages": [
        { "id": "reported", "label": "Reported", "lane": "todo", "next": ["confirmed", "wontfix", "duplicate"] },
        { "id": "confirmed", "label": "Confirmed", "lane": "todo", "next": ["fixing"] },
        { "id": "fixing", "label": "Fixing", "lane": "doing", "next": ["verifying"] },
        { "id": "verifying", "label": "Verifying", "lane": "review", "next": ["closed", "fixing"] },
        { "id": "closed", "label": "Closed", "lane": "done" },
        { "id": "wontfix", "label": "Won't fix", "lane": "dropped", "requires": ["reason"] },
        { "id": "duplicate", "label": "Duplicate", "lane": "dropped", "requires": ["duplicateOf"] }
      ],
      "fields": ["severity", "repro", "expected", "actual", "environment", "foundIn", "reporter", "duplicateOf", "reason"],
      "groups": [
        { "id": "report", "label": "Report", "fields": ["severity", "environment", "foundIn", "reporter"] },
        { "id": "repro", "label": "Steps", "fields": ["repro", "expected", "actual"] }
      ],
      "view": "card",
      "title": "title",
      "assignee": "assignee",
      "tabs": ["overview", "links", "discussion", "tests", "media", "work", "activity"],
      "card": { "progress": "ac", "chips": ["severity"] },
      "links": [
        { "field": "parent", "to": ["epic", "story"], "label": "Parent", "inverse": "Children" },
        { "field": "duplicateOf", "to": ["bug"], "label": "Duplicate of", "inverse": "Duplicates" },
        { "field": "foundIn", "to": ["test-case"], "label": "Found in", "inverse": "Found" },
        { "field": "tests", "to": ["test-case"], "label": "Verified by", "inverse": "Verifies" },
        {
          "field": "blockedBy",
          "to": ["epic", "story", "task", "bug", "debt", "test-plan", "test-case", "question", "decision", "todo", "dependency"],
          "label": "Blocked by",
          "inverse": "Blocks"
        },
        { "field": "deps", "to": ["dependency"], "label": "Dependencies", "inverse": "Dependency of" }
      ],
      "signals": ["conflict", "needs", "attention", "trail", "archived"],
      "groupBy": "parent",
      "done": { "needs": ["verified"], "mode": "refuse" }
    },
