{
  "$schema": "./item-types.schema.json",
  "version": 1,
  "lanes": ["todo", "doing", "review", "done", "dropped"],
  "content": {
    "line": { "markup": false, "newlines": false, "block": "^([#|>]|```|([-*]|[0-9]+\\.) )" },
    "slug": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "rich": {
      "rule": "rich-v1",
      "bullets": 12,
      "bulletMax": 160,
      "leadMax": 160,
      "shortMax": 120,
      "bullet": "^ {0,4}([-*]|[0-9]+\\.) [^ \\t]",
      "image": "^!\\[[^\\]\\n]{1,120}\\]\\(img:([0-9]+)\\)$",
      "forbidden": [
        { "name": "heading", "pattern": "^[ \\t]*#" },
        { "name": "table", "pattern": "^[ \\t]*\\|" },
        { "name": "quote", "pattern": "^[ \\t]*>" },
        { "name": "code fence", "pattern": "^[ \\t]*```" },
        { "name": "html", "pattern": "<[a-zA-Z/]" }
      ]
    },
    "enum": {},
    "ref": {
      "kinds": {
        "item": "^I-[0-9]+$",
        "test": "^T-[0-9]+$",
        "bundle": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
        "build": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "refs": {},
    "date": { "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "person": { "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "records": {},
    "flag": {}
  },
  "baseFields": ["title", "description", "ac", "subject"],
  "fields": {
    "title": { "content": "line", "max": 80, "required": true },
    "description": { "content": "rich", "max": 500, "images": 6 },
    "goal": { "content": "rich", "max": 500, "images": 6 },
    "repro": { "content": "rich", "max": 500, "images": 6 },
    "ac": { "content": "line", "max": 120, "list": 12 },
    "role": { "content": "line", "max": 80 },
    "want": { "content": "line", "max": 80 },
    "benefit": { "content": "line", "max": 80 },
    "expected": { "content": "line", "max": 200 },
    "actual": { "content": "line", "max": 200 },
    "payoff": { "content": "line", "max": 200 },
    "environment": { "content": "line", "max": 120 },
    "env": { "content": "line", "max": 120 },
    "area": { "content": "line", "max": 40 },
    "subject": { "content": "slug", "max": 40 },
    "question": { "content": "line", "max": 240 },
    "option": { "content": "line", "max": 60, "list": 6 },
    "decision": { "content": "line", "max": 200 },
    "context": { "content": "line", "max": 600 },
    "todo": { "content": "line", "max": 200 },
    "note": { "content": "rich", "max": 300, "images": 3 },
    "reason": { "content": "line", "max": 120 },
    "caption": { "content": "line", "max": 120 },
    "setup": { "content": "line", "max": 300 },
    "steps": { "content": "line", "max": 240, "list": 15 },
    "pass": { "content": "line", "max": 200, "list": 8 },
    "fail": { "content": "line", "max": 200, "list": 8 },
    "resultNote": { "content": "line", "max": 300 },
    "severity": {
      "content": "enum",
      "values": ["S1", "S2", "S3", "S4"],
      "labels": ["blocker", "major", "minor", "cosmetic"],
      "required": true
    },
    "cost": { "content": "enum", "values": ["S", "M", "L"] },
    "risk": { "content": "enum", "values": ["low", "medium", "high"] },
    "mode": { "content": "enum", "values": ["auto", "manual"], "labels": ["AI", "manual"] },
    "foundIn": { "content": "ref", "to": ["test", "bundle"] },
    "duplicateOf": { "content": "ref", "to": ["item"] },
    "bundle": { "content": "ref", "to": ["bundle"] },
    "cases": { "content": "refs", "to": ["test"] },
    "reporter": { "content": "person" },
    "assignee": { "content": "person" },
    "todoAssignee": { "content": "person", "leads": true },
    "target": { "content": "date" },
    "plan": { "content": "ref", "to": ["item"] },
    "build": { "content": "ref", "to": ["build"] },
    "results": { "content": "records" },
    "summary": { "content": "line", "max": 300 },
    "for": { "content": "ref", "to": ["item"] },
    "master": { "content": "flag" },
    "cmd": { "content": "line", "max": 400 },
    "cwd": { "content": "line", "max": 260 },
    "kind": { "content": "enum", "values": ["app", "dev", "other"] },
    "window": { "content": "flag" },
    "current": { "content": "flag" },
    "useEvery": { "content": "line", "max": 8 },
    "path": { "content": "line", "max": 260 },
    "branch": { "content": "line", "max": 80 },
    "commit": { "content": "line", "max": 40 },
    "state": { "content": "line", "max": 40 },
    "dirty": { "content": "line", "max": 12 },
    "ahead": { "content": "line", "max": 12 },
    "item": { "content": "ref", "to": ["item"] },
    "linkSource": { "content": "enum", "values": ["manual", "agent", "branch", "text"] }
  },
  "types": [
    {
      "id": "epic",
      "label": "Epic",
      "code": "E",
      "icon": "zap",
      "color": "violet",
      "collection": "items",
      "parents": [],
      "stages": [
        { "id": "open", "label": "Open", "lane": "todo" },
        { "id": "active", "label": "Active", "lane": "doing" },
        { "id": "closing", "label": "Closing", "lane": "review" },
        { "id": "done", "label": "Done", "lane": "done" },
        { "id": "dropped", "label": "Dropped", "lane": "dropped" }
      ],
      "fields": ["goal", "target"],
      "groups": [{ "id": "plan", "label": "Plan", "fields": ["goal", "target"] }],
      "view": "card",
      "title": "title",
      "assignee": "assignee",
      "tabs": ["overview", "children", "links", "discussion", "media", "work", "activity"],
      "card": { "progress": "children", "chips": [] },
      "links": [
        {
          "field": "children",
          "to": ["story", "task", "bug", "debt", "test-plan"],
          "label": "Children",
          "inverse": "Parent"
        },
        {
          "field": "blockedBy",
          "to": ["epic", "story", "task", "bug", "debt", "test-plan", "test-case", "question", "decision", "todo", "dependency"],
          "label": "Blocked by",
          "inverse": "Blocks"
        },
        { "field": "deps", "to": ["dependency"], "label": "Dependencies", "inverse": "Dependency of" }
      ],
      "signals": ["conflict", "needs", "attention", "trail", "archived"],
      "done": { "needs": ["children"], "mode": "refuse" }
    },
    {
      "id": "story",
      "label": "Story",
      "code": "S",
      "icon": "bookmark",
      "color": "green",
      "collection": "items",
      "parents": ["epic"],
      "parentRequired": true,
      "stages": [
        { "id": "draft", "label": "Draft", "lane": "todo" },
        { "id": "ready", "label": "Ready", "lane": "todo" },
        { "id": "building", "label": "Building", "lane": "doing" },
        { "id": "review", "label": "Review", "lane": "review" },
        { "id": "done", "label": "Done", "lane": "done" },
        { "id": "dropped", "label": "Dropped", "lane": "dropped" }
      ],
      "fields": ["role", "want", "benefit"],
      "groups": [{ "id": "story", "label": "Story", "fields": ["role", "want", "benefit"] }],
      "view": "card",
      "title": "title",
      "assignee": "assignee",
      "tabs": ["overview", "children", "links", "discussion", "tests", "media", "work", "activity"],
      "card": { "progress": "children-ac", "chips": [] },
      "links": [
        { "field": "parent", "to": ["epic"], "label": "Parent", "inverse": "Children" },
        { "field": "children", "to": ["task", "bug", "debt", "test-plan"], "label": "Children", "inverse": "Parent" },
        { "field": "tests", "to": ["test-case"], "label": "Verified by", "inverse": "Verifies" },
        {
          "field": "blockedBy",
          "to": ["epic", "story", "task", "bug", "debt", "test-plan", "test-case", "question", "decision", "todo", "dependency"],
          "label": "Blocked by",
          "inverse": "Blocks"
        },
        { "field": "deps", "to": ["dependency"], "label": "Dependencies", "inverse": "Dependency of" }
      ],
      "signals": ["conflict", "needs", "attention", "trail", "archived"],
      "groupBy": "parent",
      "done": { "needs": ["ac", "children", "tests"], "mode": "refuse" }
    },
    {
      "id": "task",
      "label": "Task",
      "code": "K",
      "icon": "circle-check",
      "color": "blue",
      "collection": "items",
      "parents": ["epic", "story"],
      "parentRequired": true,
      "stages": [
        { "id": "todo", "label": "To do", "lane": "todo" },
        { "id": "doing", "label": "Doing", "lane": "doing" },
        { "id": "review", "label": "Review", "lane": "review" },
        { "id": "done", "label": "Done", "lane": "done" },
        { "id": "dropped", "label": "Dropped", "lane": "dropped" }
